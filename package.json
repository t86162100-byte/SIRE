{
  "name": "vite-react-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx runtime-server.mjs",
    "postinstall": "if [ \"$RENDER\" = \"true\" ]; then echo \"Skipping Puppeteer Chrome download on Render\"; else puppeteer browsers install chrome; fi",
    "autonomous:market-worker": "node autonomous/market-worker.mjs",
    "autonomous:free-poll": "node autonomous/free-market-poll.mjs",
    "autonomous:sire-cycle": "tsx autonomous/sire-autonomous-cycle.ts",
    "test:paper": "node --import tsx --test backend/sire-paper-exchange.test.mjs backend/trading-safety.test.mjs",
    "test:bitget-demo": "node --import tsx --test backend/bitget-demo-lifecycle.test.mjs"
  },
  "dependencies": {
    "@appdeploy/client": "file:./compat/appdeploy-client",
    "@appdeploy/sdk": "file:./compat/appdeploy-sdk",
    "openalgo-charts": "2.4.8",
    "lucide-react": "^0.469.0",
    "pg": "^8.13.1",
    "puppeteer": "^24.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "@reown/appkit": "^1.8.4",
    "@reown/appkit-adapter-ethers": "^1.8.4",
    "ethers": "^6.15.0",
    "@solana/web3.js": "^1.98.4",
    "tronweb": "^6.5.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
